PORT=3000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Email Notification Configuration (Optional)
# If left empty, system automatically uses Nodemailer Ethereal test inbox (instant preview links in console)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key_or_password
EMAIL_FROM="Virtual Event Platform <notifications@virtualevent.local>"
